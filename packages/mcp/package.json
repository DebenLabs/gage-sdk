{
  "name": "gage-mcp",
  "version": "0.6.0",
  "mcpName": "cash.gage/gage",
  "type": "module",
  "description": "gage's MCP server for agents with their own wallet: `npx -y gage-mcp init`, then borrow and earn on gage. Robinhood Chain under spend limits, and its testnet.",
  "license": "MIT",
  "homepage": "https://gage.cash/agents/valet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DebenLabs/gage-sdk.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/DebenLabs/gage-sdk/issues"
  },
  "keywords": [
    "gage",
    "mcp",
    "model-context-protocol",
    "agents",
    "robinhood-chain",
    "wallet"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gage-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node dist/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "gage-sdk": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "viem": "2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
